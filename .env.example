# Local API configuration. Copy to .env; never commit real credentials.
PORT=3000
DATABASE_URL=postgresql://tenisu:tenisu@localhost:5432/tenisu
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Generate with: openssl rand -hex 32
# Leave empty to disable POST /api/players. Minimum: 32 bytes.
PLAYER_WRITE_API_KEY=

# Cloud scripts use exported variables or the active gcloud project.
# They do not load .env. Production secrets belong in Secret Manager.
# export GCP_PROJECT_ID=your-project-id
# export GCP_REGION=europe-west1
